  "dependencies": {
    "@agenttrace/db": "workspace:*",
    "@agenttrace/manifest": "workspace:*",
    "@solana/web3.js": "1.98.4",
    "pino": "10.3.1"
  },
  "devDependencies": {
    "pino-pretty": "13.1.3",
    "tsx": "4.23.12",
    "typescript": "7.0.2",
    "vitest": "4.1.10"
  }
}
