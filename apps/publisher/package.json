    "pino": "10.3.1"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.5.5",
    "pino-pretty": "13.1.3",
    "tsx": "4.23.12",
    "typescript": "7.0.2",
    "vitest": "4.1.10"
  }
}
