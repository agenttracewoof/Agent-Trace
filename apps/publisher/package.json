{
  "name": "@agenttrace/publisher",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    "./loop": "./src/loop.ts",
    "./memo": "./src/memo.ts"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
