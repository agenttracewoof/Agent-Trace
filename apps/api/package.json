{
  "name": "@agenttrace/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    "./harness": "./src/harness.ts"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "seed:project": "tsx src/scripts/seed-project.ts",
    "start": "node dist/index.js",
    "build": "tsc -p tsconfig.build.json",
    "test": "vitest run --passWithNoTests",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@agenttrace/db": "workspace:*",
    "@agenttrace/manifest": "workspace:*",
    "@agenttrace/shared": "workspace:*",
    "@agenttrace/verify": "workspace:*",
    "@hono/node-server": "2.1.0",
    "@hono/zod-validator": "0.9.0",
    "better-auth": "1.6.27",
    "drizzle-orm": "0.45.2",
    "hono": "4.13.2",
    "pino": "10.3.1",
    "resend": "6.19.0",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.5.5",
    "pino-pretty": "13.1.3",
    "tsx": "4.23.12",
    "typescript": "7.0.2",
    "vitest": "4.1.10"
  }
}
