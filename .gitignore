# Arena tooling — оголошує, що це підрядна робота (07-MULTI-PROJECT-SETUP)
.arena.json

# Внутрішні документи не потрапляють у репозиторій клієнта (00-BOOTSTRAP).
# Правило стоїть ДО першого коміту: інакше потрібен git rm --cached,
# а в запушеному репо — переписування історії.
*.md
!README.md
# Специфікація формату — продуктова документація, не підрядний документ: FR-026
# обіцяє, що за нею сумісний клієнт пишеться іншою мовою, а обіцянка нічого не
# варта, поки документ не доїхав до того, хто його читатиме.
!docs/MANIFEST-FORMAT.md

# Секрети
.env
.env.*
!.env.example
*.keypair.json
id.json

# Збірка і кеші
node_modules/
dist/
.turbo/
coverage/
*.tsbuildinfo

# Локальний буфер SDK і архіви
.agenttrace/

