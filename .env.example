# --- База даних -------------------------------------------------------------
# Порт 6543 = transaction pooler. Обовʼязковий: api і publisher — два сервіси,
# а прямих підключень на free tier лише два. З pgbouncer prepare має бути false.
DATABASE_URL=postgresql://user:pass@host:6543/postgres

# --- Solana -----------------------------------------------------------------
# До віхи M5 — devnet. Devnet періодично скидають: якорі там одноразові.
SOLANA_CLUSTER=devnet
SOLANA_RPC_URL=https://devnet.helius-rpc.com/?api-key=REPLACE_ME

# Гаманець, який платить комісії за якорі. Підписів манифестів НЕ робить:
# його компрометація дає витратити SOL, але не підробити жодного рішення.
PUBLISHER_SECRET_KEY=base58-encoded-secret-key

# Стеля пріоритетної комісії на якір. Перевищення → відкладаємо і попереджаємо,
# не платимо мовчки (PLAN.md → R4).
PUBLISHER_MAX_PRIORITY_LAMPORTS=10000

# --- Auth -------------------------------------------------------------------
BETTER_AUTH_SECRET=generate-random-32-char-string
BETTER_AUTH_URL=http://localhost:8787
RESEND_API_KEY=re_REPLACE_ME
AUTH_EMAIL_FROM=noreply@example.com

# --- Архіви (FR-028/FR-029) -------------------------------------------------
SUPABASE_URL=https://REPLACE_ME.supabase.co
SUPABASE_SERVICE_ROLE_KEY=REPLACE_ME
ARCHIVE_BUCKET=manifests

# --- Сервіси ----------------------------------------------------------------
API_PORT=8787
LOG_LEVEL=info
PUBLIC_APP_URL=http://localhost:5173

# --- Фронтенд (Vite, префікс VITE_ потрапляє у бандл — жодних секретів) -----
VITE_API_URL=http://localhost:8787
